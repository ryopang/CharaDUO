    "Clips you don't save are deleted when the match ends.": {
      "comment": "Consent card",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips you don't save are deleted when the match ends."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しなかったクリップは、試合終了時に削除されます。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "冇儲存嘅片段，比賽完咗就會刪除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有保存的片段会在比赛结束时删除。"
