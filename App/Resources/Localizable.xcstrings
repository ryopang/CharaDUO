    "The round is on hold. Pick up where you left off when everyone's ready.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The round is on hold. Pick up where you left off when everyone's ready."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラウンドは一時停止中です。準備ができたら続きから再開しましょう。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "今輪暫停咗。大家準備好就繼續。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮已暂停。大家准备好后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本輪暫停中。大家準備好後再繼續。"
