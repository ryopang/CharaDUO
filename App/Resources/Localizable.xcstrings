    "You can turn the camera off any time in Settings. The game plays fine without it.": {
      "comment": "Consent card",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can turn the camera off any time in Settings. The game plays fine without it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラは設定からいつでもオフにできます。カメラがなくても問題なく遊べます。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時可以喺「設定」關咗個相機。冇佢遊戲一樣玩得。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以随时在“设置”中关闭相机，没有它游戏也能正常玩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隨時在「設定」中關閉相機，沒有它遊戲也能正常玩。"
          }
        }
      }
    }
