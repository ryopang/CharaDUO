    "Off: no highlight reel, and no scoreboard on the outer display. The game plays normally.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: no highlight reel, and no scoreboard on the outer display. The game plays normally."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OFF: ハイライトリールも外側ディスプレイのスコアボードもなくなります。ゲームは通常どおり遊べます。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉：冇精華回放，外屏幕都冇計分板。遊戲照玩得。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：没有精华回顾，外屏也不显示计分板。游戏照常进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉：不會有精華回顧，外部螢幕也不會顯示計分板。遊戲仍可正常進行。"
          }
        }
      }
    },
    "Only changes the words for this match. The app's language stays as it is.": {
      "comment": "Custom Game: footer under the word-language picker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only changes the words for this match. The app's language stays as it is."
          }
        },
