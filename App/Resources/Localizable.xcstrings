    "+%lld": {
      "comment": "A number that appears in the center of the screen as feedback for a correct or incorrect answer. The number is either positive (for a correct answer) or negative (for an incorrect answer).",
      "isCommentAutoGenerated": true
    },
    "2 teams · 2 rounds each · 1 random topic": {
      "comment": "Quick Play caption",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 teams · 2 rounds each · 1 random topic"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2チーム · 各2ラウンド · ランダムなお題1つ"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "2 隊 · 每隊 2 輪 · 隨機 1 個主題"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 队 · 每队 2 轮 · 随机 1 个主题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2 隊 · 每隊 2 輪 · 隨機 1 個主題"
          }
        }
      }
    },
    "A soft tick every second during a round, sharper in the last 10 seconds. Follows your silent switch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A soft tick every second during a round, sharper in the last 10 seconds. Follows your silent switch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラウンド中は1秒ごとに小さなカチカチ音が鳴り、最後の10秒はより鋭い音になります。マナーモードの設定に従います。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每一秒都有個輕輕嘅滴答聲，最後 10 秒會清楚啲。開咗靜音就唔會響。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回合中每秒有轻轻的滴答声，最后 10 秒更明显。遵循静音开关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回合中每秒會有輕輕的滴答聲，最後 10 秒更明顯。會遵循靜音開關。"
          }
        }
      }
    },
