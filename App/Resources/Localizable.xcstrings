    "Tapping Skip costs the describing team 1 point.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping Skip costs the describing team 1 point."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「スキップ」をタップすると、出題チームが1点減点されます。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "㩒「跳過」會扣 1 分。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点“跳过”会扣 1 分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點「跳過」會扣 1 分。"
          }
        }
      }
    },
    "Tapping Skip is free — it just moves to the next word.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping Skip is free — it just moves to the next word."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「スキップ」は減点なしで、次の言葉に進むだけです。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "跳過唔使扣分，直接去下一個詞。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过不扣分，直接换下一个词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跳過不扣分，直接換下一個詞。"
          }
        }
      }
