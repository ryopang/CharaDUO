    "Describe it. Guess it. Don't say the word.": {
      "comment": "Tagline",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe it. Guess it. Don't say the word."
