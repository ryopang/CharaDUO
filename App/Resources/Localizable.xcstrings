    "Everything stays on this device. Nothing is uploaded, analysed, or shared.": {
      "comment": "Consent card",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this device. Nothing is uploaded, analysed, or shared."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこのデバイス内にとどまります。アップロード、分析、共有は一切行いません。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "所有嘢都只留喺呢部機。唔會上傳、分析或者分享。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都只保留在这部手机上，不会上传、分析或分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有內容都只會留在這支手機上，不會上傳、分析或分享。"
          }
        }
      }
    },
    "Exit Game": {
      "extractionState": "manual",
      "localizations": {
        "en": {
